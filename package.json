{
  "name": "obsidian-tencent-cos-uploader",
  "version": "1.3.1",
  "description": "Obsidian plugin to upload images to Tencent Cloud COS and replace image links in markdown files",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
    "version": "node version-bump.mjs && git add manifest.json versions.json",
    "test": "node scripts/selftest.mjs",
    "test:live": "node scripts/live-test.mjs",
    "release": "node scripts/release.mjs",
    "release:dry": "node scripts/release.mjs --dry"
  },
  "keywords": [
    "obsidian",
    "plugin",
    "tencent-cloud",
    "cos",
    "image-uploader"
  ],
  "author": "wumu2",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^20.10.0",
    "@typescript-eslint/eslint-plugin": "^6.13.0",
    "@typescript-eslint/parser": "^6.13.0",
    "builtin-modules": "^3.3.0",
    "esbuild": "^0.19.9",
    "obsidian": "latest",
    "tslib": "^2.6.2",
    "typescript": "^5.3.2"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/FreeWizardWu/obsidian-tencent-cos-uploader.git"
  }
}
